rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. LEAD SUBMISSION (bookings collection)
    match /bookings/{bookingId} {
      // Anyone can create a new booking if it meets clinical validation standards
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() >= 2 
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.mobile is string 
                    && request.resource.data.mobile.size() == 10
                    && request.resource.data.city is string 
                    && request.resource.data.city.size() >= 2
                    // System config documents are blocked from public writes
                    && !bookingId.matches('^_SYS_.*');
                    
      // STRICT PRIVACY PROTECTION: Public users CANNOT list, read, or snoop on other patients' leads!
      // Only authenticated admin staff can read, search, update, or delete customer bookings
      allow read, update, delete: if request.auth != null;
    }
    
    // 2. SYSTEM CONFIGURATION & CATALOGS (_SYS_CONFIG_...)
    match /bookings/{sysDoc} {
      allow read: if sysDoc.matches('^_SYS_CONFIG_.*');
      allow write: if request.auth != null && sysDoc.matches('^_SYS_CONFIG_.*');
    }
    
    // 3. PACKAGES & CONFIGURATION (Website Public Catalog)
    match /website_packages/{pkgId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /website_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. CUSTOMER REVIEWS
    match /customer_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.name is string && request.resource.data.rating is number;
      allow update, delete: if request.auth != null;
    }

    // 5. DEFAULT DENY: Block all other unauthorized collections and paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
